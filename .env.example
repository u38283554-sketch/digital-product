# ==============================================================
# SuperDigital Platform - Environment Variables
# ==============================================================

# Supabase Public Configuration (Safe for browser / client components)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Client environment aliases (for Vite / client fallback)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Supabase Secret Admin Key (NEVER expose to client - server only!)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Razorpay Payment Gateway (Phase 3+)
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Resend Transactional Email API (Phase 5+)
RESEND_API_KEY=re_your_resend_api_key

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI Studio runtime vars
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

